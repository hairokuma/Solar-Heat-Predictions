# Bootstrap-only settings. Everything else (location, thresholds, SMTP,
# weather API key) is configured through the in-app setup wizard and stored
# in the database instead.
#
# This file is loaded by docker-compose (for the container) and, if present,
# by `flask` CLI commands on the host too (python-dotenv auto-loads .env).
# DATABASE_PATH is deliberately NOT set here: the Dockerfile already pins it
# to /data/app.db for the container, and leaving it out here means local
# `flask db ...` commands on the host fall back to config.py's own default
# (./instance/app.db) instead of trying to write to a /data that doesn't
# exist on your machine.

SECRET_KEY=change-me-to-a-random-value
PORT=5000
